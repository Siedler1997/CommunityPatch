<?xml version="1.0" encoding="utf-8" standalone="no" ?><root>
	<Display classname="ED::CDisplayEntityProps">
		  <Class>GD::CDisplaySettler</Class>
			<Model>PU_SoldierCavalry1</Model>
			<DrawPlayerColor>True</DrawPlayerColor>
			<Anim>PU_SoldierCavalry1_Run1</Anim>
			<Anim>PU_SoldierCavalry1_Idle1</Anim>
			<Anim>PU_SoldierCavalry1_Idle2</Anim>
			<Anim>PU_SoldierCavalry1_Idle3</Anim>
			<Anim>PU_SoldierCavalry1_Idle4</Anim>
			<Anim>PU_SoldierCavalry1_Idle5</Anim>
			<Anim>PU_SoldierCavalry1_Idle6</Anim>
			<Anim>PU_SoldierCavalry1_Attack1</Anim>
			<Anim>PU_SoldierCavalry1_Dying1</Anim>
			<Anim>PU_SoldierCavalry1_Hit</Anim>
	</Display>
	<Logic classname="GGL::CGLSettlerProps">
			<Class>GGL::CSettler</Class>
			<AccessCategory>AccessCategorySettler</AccessCategory>		
			<MaxHealth>150</MaxHealth>
    <NeedsPlayer>true</NeedsPlayer>
    <ForceNoPlayer>false</ForceNoPlayer>
    <Hat/>
    <Cost>
      <Gold>200</Gold>
      <Wood>50</Wood>
    </Cost>
    <Category>Military</Category>
    <Category>Leader</Category>
    <Category>CavalryLight</Category>
    <AdjustWalkAnimSpeed>true</AdjustWalkAnimSpeed>
    <Exploration>26</Exploration>
    <ArmorClass>ArmorClassNone</ArmorClass>
    <ArmorAmount>0</ArmorAmount>
    <DodgeChance>0</DodgeChance>
    <IdleTaskList>TL_MILITARY_IDLE</IdleTaskList>
    <ExperiencePoints>25</ExperiencePoints>

    <!--Armor modifier-->
    <ModifyArmor>
      <Technology>T_SoftArcherArmor</Technology>
    </ModifyArmor>

    <ModifyArmor>
      <Technology>T_PaddedArcherArmor</Technology>
    </ModifyArmor>

    <ModifyArmor>
      <Technology>T_LeatherArcherArmor</Technology>
    </ModifyArmor>

    <!-- Damage Modifier-->
    <ModifyDamage>
      <Technology>T_BetterTrainingArchery</Technology>
    </ModifyDamage>
    <ModifyExploration>
      <Technology>T_Fletching</Technology>
    </ModifyExploration>

    <ModifyMaxRange>
      <Technology>T_Fletching</Technology>
    </ModifyMaxRange>
    <ModifyDamage>
      <Technology>T_BodkinArrow</Technology>
    </ModifyDamage>

    <!-- Speed Modifier-->
    <ModifySpeed>
      <Technology>T_Shoeing</Technology>
    </ModifySpeed>

    <!-- Bonus -->
    <ModifyExploration>
      <Technology>T_SuperTechnology</Technology>
    </ModifyExploration>
    <ModifySpeed>
      <Technology>T_SuperTechnology</Technology>
    </ModifySpeed>
    <ModifyDamage>
      <Technology>T_SuperTechnology</Technology>
    </ModifyDamage>
    <ModifyArmor>
      <Technology>T_SuperTechnology</Technology>
    </ModifyArmor>

    <ModifyMaxRange>
      <Technology>T_SuperTechnology</Technology>
    </ModifyMaxRange>

    <Upgrade>
      <Type>PU_CavalryScout2</Type>
      <Category>CavalryScout</Category>
    </Upgrade>
    
    <AttractionSlots>2</AttractionSlots>
	</Logic>
	<Behavior>
		  <Logic classname="GGL::CGLAnimationBehaviorExProps">
			  <Class>GGL::CGLBehaviorAnimationEx</Class>
			  <SuspensionAnimation>PU_SoldierCavalry1_Idle1</SuspensionAnimation>
			  <AnimSet>SET_SOLDIERCAVALRY1</AnimSet>
		  </Logic>
		  <Display classname="ED::CBehaviorProps">
			  <Class>ED::CDisplayBehaviorAnimation</Class>
		</Display>
	</Behavior>
	<Behavior>
		  <Logic classname="EGL::CMovementBehaviorProps">
			  <Class>GGL::CLeaderMovement</Class>
        <Speed>480</Speed>
        <RotationSpeed>30</RotationSpeed>
        <MoveTaskList>TL_MILITARY_WALK</MoveTaskList>
        <MoveIdleAnim>PU_SoldierCavalry1_Idle1</MoveIdleAnim>
		</Logic>
		  <Display classname="ED::CBehaviorProps">
			  <Class>ED::CDisplayBehaviorMovement</Class>
		</Display>
	</Behavior>
	<Behavior> 
		  <Logic classname="EGL::CGLEBehaviorProps">
			  <Class>GGL::CBehaviorWalkCommand</Class>
		</Logic>
	</Behavior>
	<Behavior>
		  <Logic classname="GGL::CLeaderBehaviorProps">
			  <Class>GGL::CLeaderBehavior</Class>
			  <BarrackUpgradeCategory>Stable</BarrackUpgradeCategory>
            <HomeRadius>2000</HomeRadius>
			
	        <BattleTaskList>TL_BATTLE_BOW</BattleTaskList>

        <NormalAttackAnim1>PU_LeaderCavalry1_Attack1</NormalAttackAnim1>
        <NormalAttackAnim2>PU_LeaderCavalry1_Attack1</NormalAttackAnim2>
        <CounterAttackAnim>PU_LeaderCavalry1_Attack1</CounterAttackAnim>
        <FinishingMoveAnim>PU_LeaderCavalry1_Attack1</FinishingMoveAnim>
        <MissAttackAnim>PU_LeaderCavalry1_Idle1</MissAttackAnim>
        <BattleIdleAnim>PU_LeaderCavalry1_Idle1</BattleIdleAnim>
        <BattleWalkAnim>PU_LeaderCavalry1_Run1</BattleWalkAnim>
        <HitAnim>PU_LeaderCavalry1_Hit</HitAnim>

        <DamageClass>DC_Pierce</DamageClass>
        <DamageAmount>8</DamageAmount>
        <MaxRandomDamageBonus>0</MaxRandomDamageBonus>

	        <BattleWaitUntil>2500</BattleWaitUntil>

        <MissChance>12</MissChance>

        <ProjectileEffectID>FXCavalryArrow</ProjectileEffectID>
        <MaxRange>2200</MaxRange>
        <MinRange>500</MinRange>
        <AutoAttackRange>0</AutoAttackRange>

        <HealingPoints>3</HealingPoints>
        <HealingSeconds>5</HealingSeconds>

        <UpkeepCost>20</UpkeepCost>
		  </Logic>
	</Behavior>
	
	<Behavior>
		  <Logic classname="GGL::CGLBehaviorPropsDying">
			  <Class>GGL::CGLBehaviorDying</Class>
			  <DyingTaskList>TL_DIE</DyingTaskList>
		</Logic>
	</Behavior>

	<Behavior>
	    <Logic classname="EGL::CGLEBehaviorProps">
	        <Class>GGL::CLeaderEvadeBehavior</Class>
	    </Logic>
	</Behavior>

	<Behavior>
	    <Logic classname="GGL::CEvadeExecutionBehaviorProps">
	        <Class>GGL::CEvadeExecutionBehavior</Class>
	        <BasePriority>400</BasePriority>
	    </Logic>
	</Behavior>
    <Behavior>
        <Logic classname="GGL::CReplaceableEntityBehaviorProperties">
            <Class>GGL::CReplaceableEntityBehavior</Class>
            <EntityType>XD_DroppedBow</EntityType>
        </Logic>
    </Behavior>
</root>
